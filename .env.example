# Kopieren nach .env.local (wird nicht eingecheckt)

# Adresse der Bambuddy-Instanz (Dev-Proxy in vite.config.ts und server/index.js)
BAMBUDDY_URL=http://100.101.172.117:8008

# Bambuddy-API-Schlüssel für alle Geräte (Proxy setzt ihn ein, wenn das Gerät keinen schickt)
BAMBUDDY_API_KEY=

# Optional: niimblue-node REST-Dienst für den Etikettendruck vom iPhone (Phase 2)
NIIMBLUE_URL=

# Port des Produktionsservers (server/index.js)
PORT=8080
